---
import {
  articlePath,
  articlesPath,
  type ArticleEntry,
} from "../lib/content";
import { canonicalUrl } from "../lib/urls";
import ArticleGrid from "../components/ArticleGrid.astro";
import ArticleByline from "../components/ArticleByline.astro";
import MediaFrame from "../components/MediaFrame.astro";
import BaseLayout from "./BaseLayout.astro";
import { buildVideoJsonLd } from "../lib/seo";
import { getPrimaryTagColor } from "../lib/primary-tag";

interface Props {
  article: ArticleEntry;
  related: ArticleEntry[];
}
const { article, related } = Astro.props;
const { data } = article;
const path = articlePath(data.slug);
const title = data.seo?.title || `${data.title} | Gotlandstider`;
const description = data.seo?.description || data.excerpt;
const image = data.seo?.image || data.coverImage;
const iso = (value: Date | string) =>
  value instanceof Date ? value.toISOString() : String(value);
const graph: Record<string, unknown>[] = [
  {
    "@type": "Article",
    headline: data.title,
    description: data.excerpt,
    image: canonicalUrl(image),
    datePublished: iso(data.publishedAt),
    dateModified: iso(data.updatedAt),
    inLanguage: "sv-SE",
    mainEntityOfPage: canonicalUrl(path),
    author: {
      "@type": "Organization",
      name: "Gotlandstider",
      url: canonicalUrl("/#about"),
    },
    publisher: {
      "@type": "Organization",
      name: "Gotlandstider",
      logo: {
        "@type": "ImageObject",
        url: canonicalUrl("/gotlandstider-logo-512.png"),
        width: 512,
        height: 512,
      },
    },
  },
];
if (data.video) graph.push(buildVideoJsonLd(article));
const structuredData = { "@context": "https://schema.org", "@graph": graph };
const social = data.video?.socialLinks;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  image={image}
  ogType={data.video ? "video.other" : "article"}
  structuredData={structuredData}
  activeNav="articles"
  noIndex={data.seo?.noIndex}
>
  <article
    class="article-page"
    data-primary-tag={data.primaryTag}
    style={`--primary-tag-color: ${getPrimaryTagColor(data.primaryTag)}`}
  >
    <a class="back-link" href={articlesPath()}
      ><span aria-hidden="true">←</span> Tillbaka till arkivet</a
    >
    <div class="article-detail-grid">
      <div class="article-main">
        <header class="article-intro">
          <div class="article-tags">
            <span class="primary-tag">{data.primaryTag}</span>
            <span class="article-tag-pair">
              <span>{data.primaryLocation.title}</span>
              <span>{data.qualifierTag}</span>
            </span>
          </div>
          <h1>{data.title}</h1>
          <p>{data.excerpt}</p>
          <ArticleByline
            publishedAt={data.publishedAt}
            updatedAt={data.updatedAt}
            instagram={social?.instagram}
            tiktok={social?.tiktok}
          />
        </header>
        <div class="article-body prose"><slot /></div>
      </div>
      <div class="article-sidebar">
        <aside class="article-media" aria-label="Artikelmedia">
          <MediaFrame
            title={data.title}
            video={data.video}
            image={data.coverImage}
          />
        </aside>
        {
          related.length > 0 && (
            <section class="article-related" aria-labelledby="related-heading">
              <>
                <h2 id="related-heading">Fler upplevelser</h2>
                <ArticleGrid articles={related} compact />
              </>
            </section>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
