---
interface Highlight {
  label: string;
  title: string;
  description: string;
}

interface Props {
  items?: Highlight[];
  href?: string;
}

const { items = [], href } = Astro.props;
---

<div class="highlight-list">
  {
    items.map((item) =>
      href ? (
        <a class="highlight-item" href={href}>
          <span>{item.label}</span>
          <h4>{item.title}</h4>
          <p>{item.description}</p>
        </a>
      ) : (
        <div class="highlight-item">
          <span>{item.label}</span>
          <h4>{item.title}</h4>
          <p>{item.description}</p>
        </div>
      ),
    )
  }
</div>
