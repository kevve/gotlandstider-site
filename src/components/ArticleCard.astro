---
import type { ArticleEntry } from "../lib/content";
import {
  articlePath,
  getCardPresentation,
} from "../lib/content";
import { getPrimaryTagColor } from "../lib/primary-tag";

interface Props {
  article: ArticleEntry;
  compact?: boolean;
  randomCandidate?: boolean;
}

const {
  article,
  compact = false,
  randomCandidate = false,
} = Astro.props;
const card = getCardPresentation(article);
---

<article
  class:list={["article-card", { compact }]}
  data-primary-tag={article.data.primaryTag}
  data-random-card={randomCandidate || undefined}
  style={`--primary-tag-color: ${getPrimaryTagColor(article.data.primaryTag)}`}
>
  <a href={articlePath(article.data.slug)}>
    <div class="card-image">
      {!compact && <span class="card-badge">{card.badge}</span>}
      <img
        src={card.cardImage}
        alt={article.data.title}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="card-copy">
      {compact && <span class="card-badge">{card.badge}</span>}
      {!compact && <span class="card-subtitle">{card.subtitle}</span>}
      <h3>{article.data.title}</h3>
      {!compact && <p>{article.data.excerpt}</p>}
    </div>
  </a>
</article>
